{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Billing": {
    "PricingRules": [
      {
        "serviceType": "storage",
        "billingType": "FlatPerUnit",
        "unit": "GB-hour",
        "baseAmount": 0.02
      },
      {
        "serviceType": "compute",
        "billingType": "Tiered",
        "unit": "hour",
        "tiers": [
          { "threshold": 100, "rate": 0.10 },
          { "threshold": 1000, "rate": 0.08 },
          { "threshold": 999999999, "rate": 0.05 }
        ]
      },
      {
        "serviceType": "api",
        "billingType": "FixedSubscriptionPlusOverage",
        "unit": "call",
        "baseAmount": 50,
        "includedQuantity": 1000000,
        "overageRate": 0.001
      }
    ]
  }
}
